<!-- 09 · CONTATO -->
<section class="contato" id="contato">
  <div class="container contato__grade">
    <div class="contato__intro">
      <span class="legenda legenda--clara revela">Orçamento</span>
      <h2 class="titulo titulo--secao revela">
        Vamos celebrar <span class="destaque">essa história juntos?</span>
      </h2>
      <p class="revela atraso-1">Preencha o formulário e, em breve, <br class="br-mobile" />nosso time entrará em contato com você.</p>
    </div>

    <form
      class="formulario revela atraso-1"
      data-form-id="lead-form-casamentos"
      data-submit-url={submitUrl}
      data-grid-id="form-campos"
      data-success-id="form-sucesso"
    >
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none;" />
      <div id="form-campos" style="display:contents">
        {campos.map((campo) => (
          <div class={`campo${campo.full ? ' campo--inteiro' : ''}`}>
            <label for={`form-field-${campo.name}`}>
              {campo.label}
              {campo.hint && <span class="opcional"> ({campo.hint})</span>}
            </label>
            {campo.type === 'select' ? (
              <select
                id={`form-field-${campo.name}`}
                name={campo.name}
                required={campo.required}
              >
                {campo.options?.map((opt) => (
                  <option
                    value={opt.value}
                    disabled={opt.disabled}
                    selected={opt.selected}
                  >{opt.label}</option>
                ))}
              </select>
            ) : campo.type === 'textarea' ? (
              <textarea
                id={`form-field-${campo.name}`}
                name={campo.name}
                required={campo.required}
                rows={3}
                placeholder={campo.placeholder}
              />
            ) : (
              <input
                id={`form-field-${campo.name}`}
                name={campo.name}
                type={campo.type}
                required={campo.required}
                placeholder={campo.name === 'email' ? 'voce@email.com.br' : campo.placeholder}
                autocomplete={
                  campo.name === 'nome'     ? 'name'  :
                  campo.name === 'email'    ? 'email' :
                  campo.name === 'telefone' ? 'tel'   : undefined
                }
                data-datepicker={campo.datepicker ? '' : undefined}
              />
            )}
          </div>
        ))}
        <button class="botao botao--escuro" type="submit">Solicitar orçamento</button>
      </div>
      <div id="form-sucesso">
        <p>Obrigado! Em breve nossa equipe entrará em contato.</p>
      </div>
    </form>
  </div>
</section>

